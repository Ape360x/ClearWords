# Set these as environment variables (your host's dashboard, or `export` locally). Leave both empty for demo mode.

# FREE option: get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Paid alternative (used only if GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=

# Optional: override the model (defaults: gemini-3.6-flash / claude-haiku-5-5)
# CLEARWORDS_MODEL=
PORT=3000
